{
  "name": "research-helper",
  "type": "module",
  "version": "0.0.0",
  "description": "Search the literature, build Zotero collections, summarize them, and speak the report.",
  "config": {
    "addonName": "Research Helper",
    "addonID": "research-helper@suppakoko.github.io",
    "addonRef": "research-helper",
    "addonInstance": "ResearchHelper",
    "prefsPrefix": "extensions.zotero.research-helper"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suppakoko/research_helper.git"
  },
  "author": "suppakoko",
  "bugs": {
    "url": "https://github.com/suppakoko/research_helper/issues"
  },
  "homepage": "https://github.com/suppakoko/research_helper#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test:unit": "vitest run --dir test/unit",
    "test:contract": "vitest run --dir test/contract",
    "test:integration": "zotero-plugin test",
    "test": "npm run test:unit && npm run test:contract",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "release": "zotero-plugin release"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": ["*.xhtml"],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
