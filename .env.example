# Copy to .env and fill in with your own absolute paths. .env is git-ignored.
#
# These are machine-local paths, not settings: the scaffold reads them to launch
# Zotero for `npx zotero-plugin serve` and the in-Zotero test runner.
# See docs/13-testing-build-and-release.md §1.6.
#
# NEVER put an API key here. Decision D5 (docs/00-overview.md §3) keeps every
# credential in the OS keystore; .env is a plaintext file.

# Required. The Zotero 10 executable.
#   Windows: C:\Program Files\Zotero\zotero.exe
#   macOS:   /Applications/Zotero.app/Contents/MacOS/zotero
#   Linux:   /usr/lib/zotero/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=

# The DEVELOPMENT profile — never the production one. A plugin bug can damage a
# 10,000-item library. Create one with `zotero.exe -P` (docs/13 §1.6).
#   e.g. C:\Users\<user>\AppData\Roaming\Zotero\Zotero\Profiles\dev.default
ZOTERO_PLUGIN_PROFILE_PATH=

# A data directory separate from the real library, so the dev library is
# independent of it.
#   e.g. D:\ZoteroDev\data
ZOTERO_PLUGIN_DATA_DIR=

# Only needed for publishing a release from a local machine rather than CI.
# CI uses the workflow's own token (docs/13 §5.2); leave this unset otherwise.
# GITHUB_TOKEN=
